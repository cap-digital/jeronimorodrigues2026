# ============================================================
# Relatórios — integração Supabase
# Copie este arquivo para .env.local e preencha os valores.
#   cp .env.local.example .env.local
# Passo a passo completo: RELATORIOS_SETUP.md
# ============================================================

# URL do projeto Supabase (mesmo projeto usado pelo painel).
NEXT_PUBLIC_SUPABASE_URL=https://cqrpbiepyeypbkizwacu.supabase.co

# Chave pública (anon / publishable) — pode aparecer no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YN9YKLw6sludrgf9T2i_1g_Dcm8dIiK

# Chave de serviço (service_role / secret) — SEGREDO, só no servidor.
# Supabase Dashboard → Project Settings → API → service_role (ou Secret keys).
# NUNCA use o prefixo NEXT_PUBLIC_ aqui.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Acesso ao painel — senha única (portão de entrada)
# ------------------------------------------------------------
# Senha que todos digitam na tela de login. Só existe no servidor
# (nunca é enviada ao navegador). OBRIGATÓRIA: sem ela, o acesso é
# negado (fail-closed). Defina também na Vercel (Production + Preview).
SITE_PASSWORD=
